<scene version="3.8.0">
    <default name="spp" value="64"/>
    <default name="resx" value="1920"/>
    <default name="resy" value="1080"/>

    <!-- Camera and Rendering Parameters -->
    <integrator type="path" name="elm__0">
        <integer name="max_depth" value="5"/>
    </integrator>

    <sensor type="perspective" name="elm__4">
        <string name="fov_axis" value="x"/>
        <float name="fov" value="39.597755335771296"/>
        <float name="principal_point_offset_x" value="0"/>
        <float name="principal_point_offset_y" value="-0"/>
        <float name="near_clip" value="0.10000000149011612"/>
        <float name="far_clip" value="100"/>

        <transform name="to_world">
            <lookat origin="7.358891487121582, 4.9583091735839844, 6.9257907867431641" target="6.7073333263397217, 4.513037770986557, 6.3116203546524048" up="-0.32401347160339355, 0.89539563655853271, -0.30542084574699402"/>
        </transform>

        <sampler type="independent" name="sampler">
            <integer name="sample_count" value="$spp"/>
        </sampler>

        <film type="hdrfilm" name="film">
            <integer name="width" value="$resx"/>
            <integer name="height" value="$resy"/>
        </film>
    </sensor>

    <!-- Materials -->
    <bsdf type="blender_principled" id="mat-principled" name="mat-principled">
        <boolean name="two_sided" value="false"/>
        <rgb name="base_color" value="0.064802251756191254 0.1412632018327713 0.7991030216217041"/>
        <float name="roughness" value="0.010000000298023226"/>
        <float name="metallic" value="0"/>
        <float name="eta" value="1.5"/>
        <float name="alpha" value="1"/>
        <float name="diffuse_roughness" value="0"/>
        <float name="spec_ior_level" value="0.5"/>
        <rgb name="spec_tint" value="1 1 1"/>
        <float name="anisotropic" value="0"/>
        <float name="anisotropic_rot" value="0"/>
        <float name="transmission" value="0.5"/>
        <float name="clearcoat" value="0"/>
        <float name="clearcoat_roughness" value="0"/>
        <float name="clearcoat_ior" value="1.5"/>
        <rgb name="clearcoat_tint" value="1 1 1"/>
        <float name="sheen" value="0.5"/>
        <float name="sheen_roughness" value="0.25"/>
        <rgb name="sheen_tint" value="1 1 1"/>
    </bsdf>

    <bsdf type="twosided" id="default-bsdf" name="default-bsdf">
        <bsdf type="diffuse" name="bsdf"/>
    </bsdf>

    <!-- Emitters -->
    <emitter type="point" name="elm__3">
        <vector name="position" x="4.0762453079223633" y="5.9038619995117188" z="-1.0054539442062378"/>
        <rgb name="intensity" value="300 300 300"/>
    </emitter>

    <!-- Shapes -->
    <shape type="ply" name="elm__2">
        <string name="filename" value="meshes/Cube.ply"/>
        <boolean name="face_normals" value="true"/>
        <ref name="bsdf" id="mat-principled"/>
    </shape>

    <shape type="ply" name="elm__6">
        <string name="filename" value="meshes/Plane.ply"/>
        <boolean name="face_normals" value="true"/>
        <ref name="bsdf" id="default-bsdf"/>
    </shape>
</scene>
